generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  firstName String
  lastName  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())

  // İlişkiler
  results   LessonResult[]
}

model LessonResult {
  id          String   @id @default(uuid())
  userId      String
  lessonId    String   // "f-1", "q-4" veya sınav metni id'si
  wpm         Int
  errors      Int
  timeSeconds Float
  accuracy    Float
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}

model ExamContent {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.LongText
  createdAt DateTime @default(now())
}

enum Role {
  STUDENT
  ADMIN
}
